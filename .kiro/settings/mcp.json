{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "autoApprove": [
        "list_pages",
        "take_snapshot",
        "upload_file",
        "list_console_messages",
        "list_network_requests",
        "fill"
      ]
    }
  }
}