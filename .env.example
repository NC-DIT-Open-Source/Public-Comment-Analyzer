# Explicit offline demonstration. Demo output is synthetic, not an AI assessment.
APP_RUNTIME=local
APP_DATA_DIR=.data
APP_STATIC_DIR=frontend/dist/public-comment-app/browser
APP_ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGIN=http://localhost:8000
ACCESS_PASSWORD_HASH_FILE=.secrets/access_password_hash

# Configure a LangChain provider and your model/deployment identifier for analysis.
# Common providers: openai, azure_openai, anthropic, google_genai,
# bedrock_converse, ollama. The application assumes no model identifier.
LLM_PROVIDER=demo
LLM_MODEL=
LLM_API_KEY_FILE=.secrets/llm_api_key
LLM_PROVIDER_OPTIONS={}

# Persistent conservative reservations. Rates must cover every role model.
# Enter current input/output USD prices per million tokens for your provider.
LLM_BUDGET_USD=1.00
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
LLM_MAX_CALLS=1000
LLM_ENABLED=true
LLM_KILL_SWITCH_FILE=.data/STOP_LLM
